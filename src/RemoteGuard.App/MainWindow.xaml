<Window x:Class="RemoteGuard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Remote Guard" Icon="pack://application:,,,/Assets/RemoteGuard.ico"
        Width="900" Height="700" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#10141D" Foreground="#F1F5FA"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        StateChanged="OnWindowStateChanged"
        FontFamily="Segoe UI" FontSize="14">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C8D0DA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3340" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A4554" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A12616" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="OuterFrame" BorderBrush="#1C232C" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Titlebar -->
            <Border Grid.Row="0" Background="#10141A" BorderBrush="#1C232C" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                        <Image Width="16" Height="16" Source="pack://application:,,,/Assets/RemoteGuard.ico" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="TopBarTitleLabel" Text="Remote Guard" Margin="8,0,0,0" FontSize="12" Foreground="#C8D0DA" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Свернуть">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Width="10" Height="10" Stretch="None" Data="M 1,5 H 9"/>
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Развернуть">
                            <Grid Width="10" Height="10">
                                <Path x:Name="MaximizeGlyph"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1" Stretch="None" Data="M 1,1 H 9 V 9 H 1 Z"/>
                                <Path x:Name="RestoreGlyph" Visibility="Collapsed"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1" Stretch="None" Data="M 3,1 H 9 V 7 M 1,3 H 7 V 9 H 1 Z"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource CaptionCloseButton}" Click="Close_Click" ToolTip="Свернуть в трей">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Width="10" Height="10" Stretch="None" Data="M 1,1 L 9,9 M 9,1 L 1,9"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="28,20,28,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="REMOTE GUARD" Foreground="#61E8BA" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="VersionLabel" Text="v0.1.0" Foreground="#929FB4" FontSize="12" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Контроль удалённого доступа" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,4"/>
                        <TextBlock x:Name="ComputerLabel" Foreground="#929FB4" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="UpdateButton" Content="Проверить обновления" Style="{StaticResource SmallButton}" FontSize="12" Margin="0,0,8,0" Click="OnUpdateClick"/>
                            <Button x:Name="RefreshButton" Content="Обновить статус" Style="{StaticResource SmallButton}" FontSize="12" Click="OnRefreshClick"/>
                        </StackPanel>
                        <TextBlock x:Name="UpdateStatusLabel" Foreground="#929FB4" FontSize="11" HorizontalAlignment="Right" Margin="0,5,2,0"/>
                    </StackPanel>
                </Grid>

                <!-- Left: Big Toggle All | Right: Individual Service Toggles -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column -->
                    <Grid Grid.Column="0" Margin="0,0,18,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#1B2331" CornerRadius="16" Padding="18">
                            <StackPanel>
                                <TextBlock Text="ОБЩИЙ СТАТУС" Foreground="#929FB4" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="OverallStatusLabel" Text="Проверяем службы…" FontSize="21" FontWeight="SemiBold" Margin="0,6,0,6"/>
                                <TextBlock x:Name="OverallDetailLabel" Text="Определяем состояние служб…" Foreground="#A7B4C8" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="PowerButton" Grid.Row="1" Background="#61E8BA" Foreground="#10251E" IsEnabled="False" MinHeight="176" Margin="0,14,0,0" Click="OnPowerClick">
                            <StackPanel>
                                <TextBlock x:Name="PowerIcon" Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PowerLabel" Text="Проверка…" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PowerSubLabel" Text="" FontSize="12" Opacity="0.82" Margin="0,5,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Right Column: Service Toggles -->
                    <Border Grid.Column="1" Background="#1B2331" CornerRadius="16" Padding="20">
                        <StackPanel>
                            <TextBlock Text="СЛУЖБЫ УДАЛЁННОГО ДОСТУПА" Foreground="#61E8BA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <!-- Tailscale -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="TailscaleDot" Width="10" Height="10" Fill="#5C677D" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Tailscale VPN" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TailscaleDetail" Text="Проверка…" Foreground="#929FB4" FontSize="12"/>
                                </StackPanel>
                                <CheckBox x:Name="TailscaleToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Tag="Tailscale" Click="OnServiceToggleClick"/>
                            </Grid>

                            <Border Background="#293449" Height="1" Margin="0,10"/>

                            <!-- SSH -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="SshDot" Width="10" Height="10" Fill="#5C677D" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="OpenSSH (SSH)" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SshDetail" Text="Проверка…" Foreground="#929FB4" FontSize="12"/>
                                </StackPanel>
                                <CheckBox x:Name="SshToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Tag="Ssh" Click="OnServiceToggleClick"/>
                            </Grid>

                            <Border Background="#293449" Height="1" Margin="0,10"/>

                            <!-- RDP -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="RdpDot" Width="10" Height="10" Fill="#5C677D" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Удалённый рабочий стол (RDP)" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="RdpDetail" Text="Проверка…" Foreground="#929FB4" FontSize="12"/>
                                </StackPanel>
                                <CheckBox x:Name="RdpToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Tag="Rdp" Click="OnServiceToggleClick"/>
                            </Grid>

                            <Border Background="#293449" Height="1" Margin="0,10"/>

                            <!-- AnyDesk -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="AnyDeskDot" Width="10" Height="10" Fill="#5C677D" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="AnyDesk" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AnyDeskDetail" Text="Проверка…" Foreground="#929FB4" FontSize="12"/>
                                </StackPanel>
                                <CheckBox x:Name="AnyDeskToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Tag="AnyDesk" Click="OnServiceToggleClick"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Bottom: Logs -->
                <Border Grid.Row="2" Background="#1B2331" CornerRadius="16" Padding="16" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="ЛОГИ" Foreground="#61E8BA" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Копировать" Style="{StaticResource SmallButton}" FontSize="11" Padding="10,5" Margin="0,0,8,0" Click="OnCopyLogsClick"/>
                                <Button Content="Очистить" Style="{StaticResource SmallButton}" FontSize="11" Padding="10,5" Click="OnClearLogsClick"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="#10141D" CornerRadius="10" Padding="10,8" BorderBrush="#242F42" BorderThickness="1">
                            <TextBox x:Name="LogTextBox"
                                     Background="Transparent"
                                     Foreground="#C8D0DA"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Footer Note -->
                <TextBlock x:Name="NoteLabel" Grid.Row="3"
                           Text="Крестик сворачивает окно в трей. Двойной клик по значку щита возле часов открывает окно."
                           Foreground="#929FB4" FontSize="12" Margin="2,12,2,0" TextWrapping="Wrap"/>
            </Grid>
        </Grid>
    </Border>
</Window>
